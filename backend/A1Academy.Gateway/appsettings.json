{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "adminRoute": {
        "ClusterId": "adminCluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "categoriesRoute": {
        "ClusterId": "adminCluster",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "teacherSubjectRequestsRoute": {
        "ClusterId": "adminCluster",
        "Match": { "Path": "/api/teacher-subject-requests/{**catch-all}" }
      },
      "teacherSubjectsRoute": {
        "ClusterId": "teacherCluster",
        "Match": { "Path": "/api/teacher/subjects/{**catch-all}" }
      },
      "teacherClassesRoute": {
        "ClusterId": "teacherCluster",
        "Match": { "Path": "/api/teacher/classes/{**catch-all}" }
      },
      "studentClassesRoute": {
        "ClusterId": "studentCluster",
        "Match": { "Path": "/api/student/classes/{**catch-all}" }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": { "destination1": { "Address": "https://a1academy-auth.greenfield-88918092.malaysiawest.azurecontainerapps.io/" } }
      },
      "adminCluster": {
        "Destinations": { "destination1": { "Address": "https://a1academy-admin.greenfield-88918092.malaysiawest.azurecontainerapps.io/" } }
      },
      "teacherCluster": {
        "Destinations": { "destination1": { "Address": "https://a1academy-teacher.greenfield-88918092.malaysiawest.azurecontainerapps.io/" } }
      },
      "studentCluster": {
        "Destinations": { "destination1": { "Address": "https://a1academy-student.greenfield-88918092.malaysiawest.azurecontainerapps.io/" } }
      }
    }
  }
}