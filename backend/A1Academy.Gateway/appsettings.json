{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "adminRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "categoriesRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "teacherSubjectRequestsRoute": {
        "ClusterId": "adminCluster",
        "Match": {
          "Path": "/api/teachersubjectrequests/{**catch-all}"
        }
      },
      "teacherSubjectsRoute": {
        "ClusterId": "teacherCluster",
        "Match": {
          "Path": "/api/teachersubjects/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "adminCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "teacherCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5103/"
          }
        }
      }
    }
  }
}
