{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "wdio run wdio.conf.cjs",
    "e2e:teacher": "wdio run wdio.conf.cjs --grep 'E2E: Teacher'",
    "e2e:login": "wdio run wdio.conf.cjs --grep 'Login Flow'",
    "e2e:dashboard": "wdio run wdio.conf.cjs --grep 'Dashboard'"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "chromedriver": "^152.0.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "selenium-webdriver": "^4.49.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "webdriverio": "^9.31.5"
  }
}
